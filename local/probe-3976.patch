+    def _probe3976_state_report(self):
+        # TEMPORARY #3976 probe, not for commit.
+        import collections
+        import sys
+
+        if isinstance(self.optimizer, ChainedOptimizer):
+            optimizer_state = self.optimizer.state
+        else:
+            optimizer_state = self.optimizer._get_state()
+        n = 0
+        cuda_bytes = 0
+        types = collections.Counter()
+        dtypes = collections.Counter()
+        storages = set()
+        views = 0
+        oversized = 0
+        refcounts = collections.Counter()
+        for _, state in optimizer_state.items():
+            for k, v in state.items():
+                if not torch.is_tensor(v):
+                    continue
+                n += 1
+                types[type(v).__name__] += 1
+                dtypes[f"{k}:{v.dtype}"] += 1
+                if v.is_cuda:
+                    cuda_bytes += v.numel() * v.element_size()
+                st = v.untyped_storage()
+                storages.add(st.data_ptr())
+                if v._base is not None:
+                    views += 1
+                if st.nbytes() != v.numel() * v.element_size():
+                    oversized += 1
+                refcounts[sys.getrefcount(v)] += 1
+        buf_bytes = collections.Counter()
+        if isinstance(self.model, DistributedDataParallel):
+            for buffers in [self.model.buffers, self.model.expert_parallel_buffers]:
+                for b in buffers:
+                    if b.param_data is not None:
+                        buf_bytes["param_data"] += b.param_data.untyped_storage().nbytes()
+                    if b.grad_data is not None:
+                        buf_bytes["grad_data"] += b.grad_data.untyped_storage().nbytes()
+        print(
+            f"[3976-probe] state: tensors={n} unique_storages={len(storages)} "
+            f"views={views} storage_larger_than_tensor={oversized} "
+            f"cuda_GiB={cuda_bytes / 2**30:.3f} types={dict(types)} dtypes={dict(dtypes)} "
+            f"refcounts={dict(refcounts)} buffers_GiB="
+            f"{ {k: round(v / 2**30, 3) for k, v in buf_bytes.items()} } "
+            f"allocated_GiB={torch.cuda.memory_allocated() / 2**30:.3f}",
+            flush=True,
+        )
+
